APP_ENV=development
DATABASE_URL=postgresql+asyncpg://commerce:commerce@db:5432/commerce
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
VITE_API_BASE_URL=http://localhost:8000
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash
MODEL_BASE_URL=https://api.deepseek.com
# Docker 从 gitignored 的 .env.ds 原始文本文件读取 Key；本地运行也可设置 MODEL_API_KEY。
MODEL_API_KEY_FILE=/run/secrets/deepseek_api_key
# DeepSeek V4 Flash 按 cache miss 输入价格保守估算，单位为 USD / 1M tokens。
MODEL_INPUT_COST_PER_MILLION=0.14
MODEL_OUTPUT_COST_PER_MILLION=0.28
# CPU 本地运行的中文 Embedding；首次启动会下载约 90MB ONNX 模型并持久化缓存。
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=/models/fastembed
EMBEDDING_THREADS=2
EMBEDDING_MIN_VECTOR_SIMILARITY=0.65
EMBEDDING_MIN_RELATIVE_RELEVANCE=0.95
